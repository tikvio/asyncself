# Copy this file to $HOME/.config/asyncself/secrets.env.
# Never commit the real file. On Linux/WSL, run: chmod 600 "$HOME/.config/asyncself/secrets.env"

export LINEAR_API_KEY="replace-me"

# GitHub profile
export GH_TOKEN="replace-me"
# export GITHUB_TOKEN="replace-me"

# GitLab profile
export GITLAB_TOKEN="replace-me"

# Required only when webhook mode is enabled
export LINEAR_WEBHOOK_SECRET="replace-me"
export GITLAB_WEBHOOK_SECRET="replace-me"
