# Copy to gitlab.env. Keep all secret values in an ignored shared file.
export ASYNCSELF_PROFILE=gitlab
export ASYNCSELF_CODE_HOST=gitlab
# Store the real file outside this repository and restrict it to the current user.
export ASYNCSELF_SHARED_ENV_FILE="$HOME/.config/asyncself/secrets.env"
export ASYNCSELF_WORKFLOW="$ASYNCSELF_ROOT/elixir/WORKFLOW.md"
export ASYNCSELF_LINEAR_PROJECT_SLUG="your-linear-project-slug"
export ASYNCSELF_LINEAR_PROJECT_SLUG_ID="your-project-slug-id"
export ASYNCSELF_GATEKEEPER_ACTIVE_LABEL="your-required-label"
export ASYNCSELF_REPOSITORY_URL="https://gitlab.com/your-group/your-repository.git"
export ASYNCSELF_GITLAB_HOST="https://gitlab.com"
export ASYNCSELF_GITLAB_PROJECT="your-group/your-repository"
export ASYNCSELF_TARGET_BRANCH="your-target-branch"
export ASYNCSELF_SOURCE_REPO="$HOME/code/asyncself-sources/your-project"
export ASYNCSELF_WORKSPACE_ROOT="$HOME/code/asyncself-workspaces"
export ASYNCSELF_GATEKEEPER_PIPELINE_ROOT="$ASYNCSELF_ROOT/local-tools/dependency_pipeline"
export ASYNCSELF_RUNTIME_DIR="$ASYNCSELF_ROOT/local-config/runtime/gitlab"
export ASYNCSELF_GATEKEEPER_STATE_FILE="$ASYNCSELF_RUNTIME_DIR/gatekeeper-state.json"
export ASYNCSELF_GATEKEEPER_LOCK_FILE="$ASYNCSELF_RUNTIME_DIR/gatekeeper.lock"
export ASYNCSELF_MR_WATCHER_LOCK_ROOT="$ASYNCSELF_RUNTIME_DIR/mr-watcher-locks"
export ASYNCSELF_WEBHOOK_CONFIG="$ASYNCSELF_ROOT/local-config/profiles/gitlab.webhook.json"
